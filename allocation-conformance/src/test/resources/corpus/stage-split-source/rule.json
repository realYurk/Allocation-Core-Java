{
  "schema": "allocation-ir/2.0",
  "rounding_policy": "LARGEST_REMAINDER_IDENTITY",
  "name": "corpus scenario",
  "precision": 2,
  "dimensions": [
    "period",
    "plant",
    "sku",
    "account",
    "currency"
  ],
  "immutable_dimensions": [
    "period"
  ],
  "hierarchies": {},
  "datasets": {
    "amounts": {
      "amounts": "amounts.csv"
    },
    "drivers": {
      "drivers": "drivers.csv"
    }
  },
  "stages": [
    {
      "id": "share-a",
      "inputs": [
        {
          "from": "amounts",
          "share": "0.3"
        }
      ],
      "source": {
        "grouping": {
          "period": "AS_IS",
          "plant": "AS_IS",
          "sku": "TOTAL",
          "account": "AS_IS",
          "currency": "AS_IS"
        },
        "filters": {}
      },
      "target": {
        "period": {
          "mode": "SOURCE"
        },
        "plant": {
          "mode": "SOURCE"
        },
        "sku": {
          "mode": "INCLUDE",
          "include": [
            "S0",
            "S1"
          ]
        },
        "account": {
          "mode": "SOURCE"
        },
        "currency": {
          "mode": "SOURCE"
        }
      },
      "conservation_keys": [
        "period",
        "plant",
        "account",
        "currency"
      ],
      "allocations": [
        {
          "id": "r1",
          "share": "1",
          "driver_dataset": "drivers",
          "weight_field": "weight"
        }
      ]
    },
    {
      "id": "share-b",
      "inputs": [
        {
          "from": "amounts",
          "share": "0.7"
        }
      ],
      "source": {
        "grouping": {
          "period": "AS_IS",
          "plant": "AS_IS",
          "sku": "TOTAL",
          "account": "AS_IS",
          "currency": "AS_IS"
        },
        "filters": {}
      },
      "target": {
        "period": {
          "mode": "SOURCE"
        },
        "plant": {
          "mode": "SOURCE"
        },
        "sku": {
          "mode": "INCLUDE",
          "include": [
            "S0",
            "S1"
          ]
        },
        "account": {
          "mode": "SOURCE"
        },
        "currency": {
          "mode": "SOURCE"
        }
      },
      "conservation_keys": [
        "period",
        "plant",
        "account",
        "currency"
      ],
      "allocations": [
        {
          "id": "r2",
          "share": "1",
          "driver_dataset": "drivers",
          "weight_field": "weight"
        }
      ]
    }
  ]
}
