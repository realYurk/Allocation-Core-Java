{
  "schema": "allocation-ir/2.0",
  "rounding_policy": "LARGEST_REMAINDER_IDENTITY",
  "name": "corpus scenario",
  "precision": 2,
  "dimensions": [
    "period",
    "plant",
    "sku",
    "account",
    "currency"
  ],
  "immutable_dimensions": [
    "period"
  ],
  "hierarchies": {
    "sku": {
      "sellable": [
        "S0",
        "S1"
      ],
      "sampled": [
        "S1",
        "S2"
      ]
    }
  },
  "datasets": {
    "amounts": {
      "amounts": "amounts.csv"
    },
    "drivers": {
      "drivers": "drivers.csv"
    }
  },
  "stages": [
    {
      "id": "st1",
      "inputs": [
        {
          "from": "amounts",
          "share": "1"
        }
      ],
      "source": {
        "grouping": {
          "period": "AS_IS",
          "plant": "AS_IS",
          "sku": "TOTAL",
          "account": "AS_IS",
          "currency": "AS_IS"
        },
        "filters": {}
      },
      "target": {
        "period": {
          "mode": "SOURCE"
        },
        "plant": {
          "mode": "SOURCE"
        },
        "sku": {
          "mode": "INCLUDE_EXCLUDE",
          "include": [
            "S0",
            "S1",
            "S2",
            "S3"
          ],
          "exclude": [
            "sampled"
          ]
        },
        "account": {
          "mode": "SOURCE"
        },
        "currency": {
          "mode": "SOURCE"
        }
      },
      "conservation_keys": [
        "period",
        "plant",
        "account",
        "currency"
      ],
      "allocations": [
        {
          "id": "r1",
          "share": "1",
          "driver_dataset": "drivers",
          "weight_field": "weight"
        }
      ]
    }
  ]
}
