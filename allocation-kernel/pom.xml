<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.allocation</groupId>
    <artifactId>allocation-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>allocation-kernel</artifactId>
  <name>allocation-kernel</name>

  <!--
    CONSTITUTION Art.1: this module must have ZERO third-party runtime dependencies.
    It must be instantiable from a plain `new` in a unit test, and embeddable in any
    runtime (Flink job, CLI, batch scheduler, Spring bean). Any dependency added here
    is a constitutional violation; CI runs `mvn -pl allocation-kernel dependency:list`
    and fails if the runtime classpath is anything other than the JDK.
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Test-scoped only: the shipped schema is verified by executing it. This does NOT put a JDBC driver
      on the runtime classpath, and the kernel still has no runtime dependency at all.
    -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.45.1.0</version>
      <scope>test</scope>
    </dependency>
    <!--
      Test-scoped only, and used only by the opt-in MySQL test (JdbcMySqlTest, gated behind
      -Dmysql.url). The shipped MySQL DDL has never been executed on a real server, so CI cannot prove
      it; a developer with a MySQL at hand can. Never promoted to runtime: Art.1 forbids it.
    -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.0.33</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
